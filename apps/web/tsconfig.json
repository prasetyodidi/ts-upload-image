{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["svelte", "vite/client"],
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "moduleDetection": "force"
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"],
  "exclude": ["src/**/*.test.ts"]
}
